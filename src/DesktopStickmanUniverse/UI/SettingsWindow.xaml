<Window x:Class="DesktopStickmanUniverse.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Stickman Universe — Settings"
        Width="520"
        Height="700"
        MinWidth="470"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#111520"
        Foreground="#EEF2FA"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#191F2E" />
            <Setter Property="BorderBrush" Value="#273147" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="42"
                                Height="22"
                                CornerRadius="11"
                                Background="#2E384D"
                                BorderBrush="#41506E"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Fill="#DCE4F5"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3D8BFF" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#5DA0FF" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.92" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#232B3E" />
            <Setter Property="Foreground" Value="#EAF0FA" />
            <Setter Property="BorderBrush" Value="#34405A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D3750" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2536" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#3D1F28" />
            <Setter Property="BorderBrush" Value="#693342" />
            <Setter Property="Foreground" Value="#FFD6DE" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Desktop Stickman Universe" FontSize="20" FontWeight="SemiBold" Foreground="#F6F8FC" />
                    <TextBlock Text="Autonomous Windows desktop characters &amp; live physics controls" FontSize="12.5" Foreground="#9AA8C4" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Characters & Population -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Characters" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <DockPanel Margin="0,0,0,10">
                        <CheckBox x:Name="ChkCharactersEnabled" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="OnSettingControlChanged" Unchecked="OnSettingControlChanged" />
                        <StackPanel>
                            <TextBlock Text="Enable Desktop Characters" FontSize="13" />
                            <TextBlock Text="Show or hide stickmen across all monitors" FontSize="11.5" Foreground="#8E9CB8" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <CheckBox x:Name="ChkPaused" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="OnSettingControlChanged" Unchecked="OnSettingControlChanged" />
                        <StackPanel>
                            <TextBlock Text="Pause All Animations" FontSize="13" />
                            <TextBlock Text="Freeze simulation &amp; zero overlay rendering" FontSize="11.5" Foreground="#8E9CB8" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,4,0,4">
                        <TextBlock x:Name="TxtCharCountValue" Text="4" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#6EB2FF" />
                        <TextBlock Text="Character Count" FontSize="13" />
                    </DockPanel>
                    <Slider x:Name="SldCharacterCount" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnCharacterCountChanged" Margin="0,0,0,10" />

                    <TextBlock Text="Character Colors (click a swatch to customize)" FontSize="12" Foreground="#9AA8C4" Margin="0,2,0,6" />
                    <WrapPanel x:Name="ColorSwatchesPanel" />
                </StackPanel>
            </Border>

            <!-- Behavior & Physics -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Behavior &amp; Interaction" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="TxtAnimSpeedValue" Text="1.0x" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#6EB2FF" />
                        <TextBlock Text="Animation Speed" FontSize="13" />
                    </DockPanel>
                    <Slider x:Name="SldAnimSpeed" Minimum="0.5" Maximum="2.0" SmallChange="0.1" LargeChange="0.25" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="OnSettingControlChanged" Margin="0,0,0,10" />

                    <DockPanel Margin="0,0,0,10">
                        <ComboBox x:Name="CmbActivityLevel" Width="135" DockPanel.Dock="Right" SelectionChanged="OnSettingControlChanged" Background="#F4F6FA" Foreground="#111520" FontSize="12.5">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#111520" />
                                    <Setter Property="Background" Value="#FFFFFF" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="Calm" Tag="0" />
                            <ComboBoxItem Content="Normal" Tag="1" />
                            <ComboBoxItem Content="Lively" Tag="2" />
                        </ComboBox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Activity Level" FontSize="13" />
                            <TextBlock Text="Frequency of jumps, climbs &amp; mini-events" FontSize="11.5" Foreground="#8E9CB8" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <CheckBox x:Name="ChkEnableFighting" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="OnSettingControlChanged" Unchecked="OnSettingControlChanged" />
                        <StackPanel>
                            <TextBlock Text="Playful Fighting" FontSize="13" />
                            <TextBlock Text="Allow spontaneous comic spars between characters" FontSize="11.5" Foreground="#8E9CB8" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <CheckBox x:Name="ChkEnableMouse" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="OnSettingControlChanged" Unchecked="OnSettingControlChanged" />
                        <StackPanel>
                            <TextBlock Text="Mouse Interactions" FontSize="13" />
                            <TextBlock Text="Hover, grab/throw, cursor reactions &amp; right-click menu" FontSize="11.5" Foreground="#8E9CB8" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- System & Performance -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="System &amp; Performance" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <DockPanel Margin="0,0,0,10">
                        <CheckBox x:Name="ChkPerformanceMode" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="OnSettingControlChanged" Unchecked="OnSettingControlChanged" />
                        <StackPanel>
                            <TextBlock Text="Performance Mode (Eco)" FontSize="13" />
                            <TextBlock Text="Lower active FPS cap, reduce particles &amp; window scans" FontSize="11.5" Foreground="#8E9CB8" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <CheckBox x:Name="ChkStartup" Style="{StaticResource ToggleSwitchStyle}" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                        <StackPanel>
                            <TextBlock Text="Launch at Windows Startup" FontSize="13" />
                            <TextBlock Text="Register under current user HKCU Run key" FontSize="11.5" Foreground="#8E9CB8" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Live Performance Telemetry -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Live Telemetry" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <UniformGrid Columns="3" Margin="0,0,0,4">
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="Render FPS" FontSize="11" Foreground="#8E9CB8" />
                            <TextBlock x:Name="TxtStatFps" Text="0.0 FPS" FontSize="13.5" FontWeight="SemiBold" Foreground="#6CE0A6" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="CPU Usage" FontSize="11" Foreground="#8E9CB8" />
                            <TextBlock x:Name="TxtStatCpu" Text="0.0%" FontSize="13.5" FontWeight="SemiBold" Foreground="#6EB2FF" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Private Memory" FontSize="11" Foreground="#8E9CB8" />
                            <TextBlock x:Name="TxtStatMem" Text="0.0 MB" FontSize="13.5" FontWeight="SemiBold" Foreground="#F6C46A" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Tick / Frame" FontSize="11" Foreground="#8E9CB8" />
                            <TextBlock x:Name="TxtStatFrameMs" Text="0.0 ms" FontSize="12.5" FontWeight="Medium" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Window Scan" FontSize="11" Foreground="#8E9CB8" />
                            <TextBlock x:Name="TxtStatScanMs" Text="0.0 ms" FontSize="12.5" FontWeight="Medium" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Active Overlays" FontSize="11" Foreground="#8E9CB8" />
                            <TextBlock x:Name="TxtStatOverlays" Text="0" FontSize="12.5" FontWeight="Medium" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Footer Actions -->
            <DockPanel Margin="0,4,0,4">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Scatter" Style="{StaticResource ActionButtonStyle}" Click="OnScatterClick" Margin="0,0,8,0" />
                    <Button Content="Reset Defaults" Style="{StaticResource ActionButtonStyle}" Click="OnResetDefaultsClick" />
                </StackPanel>
                <Button Content="Exit Application" Style="{StaticResource DangerButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="OnExitClick" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
